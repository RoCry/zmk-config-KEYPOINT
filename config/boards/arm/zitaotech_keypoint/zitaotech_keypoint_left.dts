#include <dt-bindings/zmk/behaviors.h>
#include "zitaotech_keypoint.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

/* Both numbers name layers declared in keypoint.keymap (POINTING and LOWER).
 * They are restated here because the keymap's #defines are not visible to this
 * board file; tests/test_pointing_layers.py parses both files and fails if they
 * ever disagree. A silent mismatch does not fail the build -- it just stops the
 * TrackPoint scrolling, or raises the wrong layer. */
#define TRACKPOINT_POINTING_LAYER 4
#define TRACKPOINT_POINTING_TIMEOUT_MS 700
#define TRACKPOINT_SCROLL_LAYER 1

/ {
    chosen {
        zmk,backlight = &backlight;
        zmk,battery = &vbatt;
        zmk,underglow = &led_strip;
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 17  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 31  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 13  GPIO_ACTIVE_HIGH>
            , <&gpio0 15  GPIO_ACTIVE_HIGH>
            , <&gpio0 19  GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio1 0 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            , <&gpio0 30 GPIO_ACTIVE_HIGH>
            ;
    };

    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
    };
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 1>;
        output-ohms = <2000000>;
        full-ohms = <2820000>;  // 2000000 + 820000
    };
};


&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&spi2 {
    status = "okay";
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};


&left_encoder {
    status = "okay";
};


/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpoint_split: trackpoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        bbtrackpad_split: bbtrackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        bbtrackball_split: bbtrackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

};



/ {
    trackpoint_listener: trackpoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpoint_split>;
    };
    bbtrackpad_listener: bbtrackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&bbtrackpad_split>;
    };
    bbtrackball_listener: bbtrackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&bbtrackball_split>;
    };
};

&trackpoint_listener {
    status = "okay";
    input-processors =
        <&zip_temp_layer TRACKPOINT_POINTING_LAYER TRACKPOINT_POINTING_TIMEOUT_MS>;

    /* Hold-to-scroll for the TrackPoint. The right half only ever reports cursor
     * motion; the decision to scroll is made here, on the central, because it is
     * a *layer* decision -- and a layer-tap held to reach it sends nothing to the
     * host. The layer number must stay in step with LOWER in keypoint.keymap;
     * tests/test_pointing_layers.py enforces that.
     *
     * The Y invert is not a preference, it is the axis convention: REL_X and
     * HWHEEL are both positive-right, but REL_Y is positive-*down* while WHEEL
     * is positive-*up*. Remapping the code alone therefore lands vertical
     * scrolling backwards -- push up, page goes down -- and disagrees with the
     * trackpad, whose driver negates exactly this one axis for the same reason
     * (`INPUT_REL_WHEEL, -ticks.y` against an un-negated cursor Y in a320.c). */
    trackpoint_layer_1_scroll {
        layers = <TRACKPOINT_SCROLL_LAYER>;
        process-next;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
    };
};

/*&trackpoint_listener {
    status = "okay";
};
*/
&bbtrackpad_listener {
    status = "okay";
};

&bbtrackball_listener {
    status = "okay";
};

lpm_view_spi: &spi2 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >;
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <400000>;
        /* WS2812 */
        chain-length = <1>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

&pinctrl {
    pwm0_default:pwm0_default{
        group1{
            psels = <NRF_PSEL(PWM_OUT0, 0, 9)>; //  backlight, unreal
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 9)>;
            bias-pull-down;
        };
    };
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 5)>,
            <NRF_PSEL(SPIM_SCK, 0, 27)>;
        };
    };
    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 5)>,
            <NRF_PSEL(SPIM_SCK, 0, 27)>;
            low-power-enable;
        };
    };
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;    // Setting for RGB light, unreal
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};
