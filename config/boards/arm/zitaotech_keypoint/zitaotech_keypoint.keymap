#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define LOWER 1
#define SYMBOL 2
#define FN 3
#define POINTING 4
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
         sp_sc: behavior_spacescroll {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <200>;       /* 长按阈值 */
           bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    macros {
        cmd_space: cmd_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp SPACE>, <&macro_release &kp LGUI>;
        };

        cmd_grave: cmd_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp GRAVE>, <&macro_release &kp LGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_jk_cmd_space {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <0>;
            bindings = <&cmd_space>;
        };

        combo_df_cmd_space {
            timeout-ms = <50>;
            key-positions = <15 16>;
            layers = <0>;
            bindings = <&cmd_space>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

         default_layer {
            display-name = "QWERTY";
           bindings = <
&kp TAB        &kp Q      &kp W      &kp E      &kp R      &kp T                                                           &kp Y         &kp U      &kp I      &kp O      &kp P         &kp BSPC
&mt LCTRL ESC  &kp A      &kp S      &kp D      &kp F      &kp G      &mkp LCLK                  &mkp LCLK                   &kp H         &kp J      &kp K      &kp L      &kp BSLH      &kp ENTER
&kp LSHFT      &kp Z      &kp X      &kp C      &kp V      &kp B      &mkp LCLK   &mkp MB3        &mkp LCLK      &mkp MB3    &kp N         &kp M      &kp COMMA  &kp DOT    &kp UP         &mt RSHFT FSLH
&kp LCTRL      &kp LALT   &kp LGUI   &kp C_MUTE &kp LALT   &mt LGUI ESC &lt LOWER SPACE                                      &lt SYMBOL BSPC &mt RSHFT TAB &mt LC(LA(LS(LGUI))) RALT &kp LC(UP)     &lt LOWER LEFT  &lt SYMBOL DOWN &lt FN RIGHT
           >;
           sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp F14 F15>;
        };


        lower_layer {
            display-name = "LOWER";
            bindings = <
&gresc    &kp N1      &kp N2     &kp N3     &kp N0     &kp N0                                                            &kp N6      &kp N7     &kp N8     &kp N9     &kp N0     &kp DEL
&kp LCTRL &kp N4      &kp N5     &kp N6     &kp N0     &kp N0    &bt BT_CLR                &trans                      &kp LEFT    &kp DOWN   &kp UP     &kp RIGHT  &trans     &trans
&kp LSHFT &kp N7     &kp N8     &kp N9     &kp N0     &cmd_grave &trans     &trans          &bl BL_DEC  &bl BL_INC      &trans      &trans     &trans     &trans     &trans     &trans
&trans    &trans     &trans     &bt BT_CLR &trans     &trans    &mo FN                                     &kp BSPC    &trans     &trans     &trans     &trans     &trans     &trans
            >;
             sensor-bindings = <&BLE_encoder &scroll_encoder>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&kp ESC   &kp EXCL   &kp AT     &kp HASH    &kp DLLR    &kp PRCNT                                                        &kp CARET   &kp AMPS   &kp STAR    &kp LPAR   &kp RPAR   &trans
&kp LCTRL &kp MINUS  &kp UNDER  &kp SQT     &kp DQT     &kp BSLH   &kp C_MUTE                 &mkp MB3                    &kp PIPE    &kp LBKT   &kp RBKT    &kp LBRC   &kp RBRC   &trans
&kp LSHFT &kp EQUAL  &kp PLUS   &kp FSLH    &kp QUESTION &kp GRAVE &trans     &trans          &trans     &trans          &kp TILDE   &kp SEMI   &kp COLON   &trans     &trans     &kp RSHFT
&trans    &trans     &trans     &trans      &kp LALT    &kp LGUI  &mo FN                                     &kp BSPC    &trans     &trans      &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_encoder>;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
&bt BT_CLR    &kp F1       &kp F2      &kp F3       &kp F4      &kp F5                                                          &kp F6   &kp F7   &kp F8    &kp F9    &kp F10  &trans
&bt BT_SEL 0  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   &kp C_PLAY  &none     &mkp LCLK                 &mkp RCLK                   &none    &mkp LCLK &mkp MB3  &none     &none    &none
&bt BT_SEL 1  &kp F14      &kp F15     &kp F11      &kp F12     &kp F13   &msc SCRL_DOWN &msc SCRL_UP &none      &none         &none    &mkp RCLK &none     &none     &none    &none
&bt BT_SEL 2  &none        &none       &none        &none       &none     &none                                      &none       &none    &none     &none     &none    &none    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_encoder>;
        };

        pointing_layer {
            display-name = "POINTING";
            bindings = <
&trans    &trans    &trans     &trans   &trans   &trans                                                &trans  &trans &trans  &trans &trans &trans
&trans    &trans    &trans     &trans   &trans   &trans  &trans                       &trans           &trans  &trans &trans  &trans &trans &trans
&trans    &trans    &trans     &trans   &trans   &trans  &trans  &trans               &trans &trans    &trans  &trans &trans  &trans &trans &trans
&trans    &trans    &trans     &trans   &trans   &trans  &trans                              &mkp LCLK  &mkp RCLK &trans &trans  &trans &trans &trans
            >;
        };

    };
};
